#: FFB_Tuner.py:132
msgid "Steering"
msgstr "Lenkung"

#: FFB_Tuner.py:133
msgid "Wheel Feel"
msgstr "Lenkgefühl"

#: FFB_Tuner.py:134
msgid "Pedals"
msgstr "Pedale"

#: FFB_Tuner.py:135
msgid "Paddles"
msgstr "Paddles"

#: FFB_Tuner.py:136
msgid "Presets"
msgstr "Presets"

#: FFB_Tuner.py:137
msgid "Tools"
msgstr "Werkzeuge"

#: FFB_Tuner.py:143
msgid "Off"
msgstr "Aus"

#: FFB_Tuner.py:145
msgid "Counter-steer {n}"
msgstr "Gegenlenken {n}"

#: FFB_Tuner.py:146
msgid "Centering +{n}"
msgstr "Zentrierung +{n}"

#: FFB_Tuner.py:153
msgid "Always on"
msgstr "Immer an"

#: FFB_Tuner.py:159
msgid "Rotation"
msgstr "Rotation"

#: FFB_Tuner.py:160
msgid "Steering Angle"
msgstr "Lenkwinkel"

#: FFB_Tuner.py:161
msgid "Total wheel rotation in degrees. Auto uses the maximum range of the wheel base."
msgstr "Gesamter Lenkwinkel in Grad. Auto verwendet den maximalen Bereich der Wheelbase."

#: FFB_Tuner.py:164
msgid "Force Feedback"
msgstr "Force Feedback"

#: FFB_Tuner.py:165
msgid "Force Feedback Strength"
msgstr "Force-Feedback-Stärke"

#: FFB_Tuner.py:166
msgid "Master force feedback output of the wheel base."
msgstr "Gesamtstärke des Force Feedbacks der Wheelbase."

#: FFB_Tuner.py:168
msgid "Force Effects"
msgstr "Kraft-Effekte"

#: FFB_Tuner.py:169
msgid "Strength of constant-force effects, the core of the game's force feedback."
msgstr "Stärke der Constant-Force-Effekte, des Kerns des Force Feedbacks im Spiel."

#: FFB_Tuner.py:172
msgid "Spring Effects"
msgstr "Feder-Effekte"

#: FFB_Tuner.py:173
msgid "Strength of centering spring effects sent by the game."
msgstr "Stärke der zentrierenden Feder-Effekte aus dem Spiel."

#: FFB_Tuner.py:175
msgid "Damper Effects"
msgstr "Dämpfer-Effekte"

#: FFB_Tuner.py:176
msgid "Strength of damper effects sent by the game."
msgstr "Stärke der Dämpfer-Effekte aus dem Spiel."

#: FFB_Tuner.py:177
msgid "Signal"
msgstr "Signal"

#: FFB_Tuner.py:178
msgid "Force Feedback Scaling"
msgstr "Force-Feedback-Skalierung"

#: FFB_Tuner.py:179
msgid "Linear"
msgstr "Linear"

#: FFB_Tuner.py:179
msgid "Peak"
msgstr "Peak"

#: FFB_Tuner.py:180
msgid "Linear keeps a constant taper. Peak scales to the strongest force (default)."
msgstr "Linear behält einen gleichmäßigen Verlauf. Peak skaliert auf die stärkste Kraft (Standard)."

#: FFB_Tuner.py:183
msgid "Force Effect Intensity"
msgstr "Force-Effekt-Intensität"

#: FFB_Tuner.py:184
msgid "Filters the force feedback signal. Higher values give sharper details."
msgstr "Filtert das Force-Feedback-Signal. Höhere Werte geben schärfere Details."

#: FFB_Tuner.py:187
msgid "Interpolation Filter"
msgstr "Interpolationsfilter"

#: FFB_Tuner.py:188
msgid "Smooths between force feedback updates. 0 turns it off."
msgstr "Glättet zwischen Force-Feedback-Updates. 0 schaltet ihn aus."

#: FFB_Tuner.py:190
msgid "Natural Feel"
msgstr "Natürliches Gefühl"

#: FFB_Tuner.py:191
msgid "Natural Damper"
msgstr "Natürlicher Dämpfer"

#: FFB_Tuner.py:192
msgid "Mechanical damping added by the wheel base itself, independent of the game."
msgstr "Mechanische Dämpfung durch die Wheelbase selbst, unabhängig vom Spiel."

#: FFB_Tuner.py:195
msgid "Natural Friction"
msgstr "Natürliche Reibung"

#: FFB_Tuner.py:196
msgid "Mechanical friction added by the wheel base itself, independent of the game."
msgstr "Mechanische Reibung durch die Wheelbase selbst, unabhängig vom Spiel."

#: FFB_Tuner.py:199
msgid "Natural Inertia"
msgstr "Natürliche Trägheit"

#: FFB_Tuner.py:200
msgid "Mechanical inertia added by the wheel base itself, independent of the game."
msgstr "Mechanische Trägheit durch die Wheelbase selbst, unabhängig vom Spiel."

#: FFB_Tuner.py:202
msgid "Effects"
msgstr "Effekte"

#: FFB_Tuner.py:203
msgid "Wheel Vibration"
msgstr "Lenkrad-Vibration"

#: FFB_Tuner.py:204
msgid "Strength of the rumble on curbs and impacts."
msgstr "Stärke der Vibration bei Curbs und Einschlägen."

#: FFB_Tuner.py:206
msgid "Drift Mode"
msgstr "Drift-Modus"

#: FFB_Tuner.py:207
msgid "Negative values help with counter-steering, positive values add centering force. 0 turns it off."
msgstr "Negative Werte helfen beim Gegenlenken, positive Werte erhöhen die Zentrierkraft. 0 schaltet ihn aus."

#: FFB_Tuner.py:210
msgid "Load Cell Brake"
msgstr "Loadcell-Bremse"

#: FFB_Tuner.py:211
msgid "Brake Force"
msgstr "Bremskraft"

#: FFB_Tuner.py:212
msgid "Pedal stiffness. Higher values need more force for full braking. Requires a load cell brake."
msgstr "Pedalhärte. Höhere Werte brauchen mehr Kraft für eine Vollbremsung. Benötigt eine Loadcell-Bremse."

#: FFB_Tuner.py:215
msgid "Brake Level Indicator"
msgstr "Bremsanzeige (LED)"

#: FFB_Tuner.py:216
msgid "Brake force at which the LED lights up."
msgstr "Bremskraft, ab der die LED aufleuchtet."

#: FFB_Tuner.py:217
msgid "Vibration"
msgstr "Vibration"

#: FFB_Tuner.py:218
msgid "FullForce"
msgstr "FullForce"

#: FFB_Tuner.py:219
msgid "Pedal vibration routed through the wheel motor. Requires a game with FullForce support."
msgstr "Pedalvibration über den Lenkradmotor. Benötigt ein Spiel mit FullForce-Unterstützung."

#: FFB_Tuner.py:222
msgid "Analogue Paddles"
msgstr "Analoge Paddles"

#: FFB_Tuner.py:223
msgid "Paddle Mode"
msgstr "Paddle-Modus"

#: FFB_Tuner.py:224
msgid "Independent (CbP)"
msgstr "Unabhängig (CbP)"

#: FFB_Tuner.py:225
msgid "Clutch / Handbrake (CH)"
msgstr "Kupplung / Handbremse (CH)"

#: FFB_Tuner.py:226
msgid "Brake / Throttle (Bt)"
msgstr "Bremse / Gas (Bt)"

#: FFB_Tuner.py:227
msgid "Analogue Axes (AnA)"
msgstr "Analoge Achsen (AnA)"

#: FFB_Tuner.py:228
msgid "How the analogue clutch paddles behave. Read-only on wheels with a physical mode switch."
msgstr "Verhalten der analogen Kupplungspaddles. Bei Lenkrädern mit Hardware-Schalter nur lesbar."

#: FFB_Tuner.py:344
msgid "Undo changes to this setting"
msgstr "Änderung dieser Einstellung rückgängig machen"

#: FFB_Tuner.py:353
msgid "About this setting"
msgstr "Über diese Einstellung"

#: FFB_Tuner.py:399
msgid "Not supported by your hardware"
msgstr "Von deiner Hardware nicht unterstützt"

#: FFB_Tuner.py:477
msgid "Slot {n}"
msgstr "Slot {n}"

#: FFB_Tuner.py:479
msgid "Tuning slot on the wheel base that is being edited"
msgstr "Tuning-Slot der Wheelbase, der gerade bearbeitet wird"

#: FFB_Tuner.py:486
msgid "Apply or save a preset"
msgstr "Preset anwenden oder speichern"

#: FFB_Tuner.py:491
msgid "Reload from Device"
msgstr "Vom Gerät neu laden"

#: FFB_Tuner.py:492
msgid "Save as Preset…"
msgstr "Als Preset speichern …"

#: FFB_Tuner.py:498
msgid "Undo all changes since the values were loaded"
msgstr "Alle Änderungen seit dem Laden rückgängig machen"

#: FFB_Tuner.py:514
msgid "Apply"
msgstr "Übernehmen"

#: FFB_Tuner.py:517
msgid "Discard"
msgstr "Verwerfen"

#: FFB_Tuner.py:574
msgid "Quick Select"
msgstr "Schnellauswahl"

#: FFB_Tuner.py:583
msgid "Auto"
msgstr "Auto"

#: FFB_Tuner.py:584
msgid "Use the maximum range of the wheel base"
msgstr "Maximalen Bereich der Wheelbase verwenden"

#: FFB_Tuner.py:596
msgid "Save Preset"
msgstr "Preset speichern"

#: FFB_Tuner.py:597
msgid "Saves all current settings under a name in ~/.config/SimPower/."
msgstr "Speichert alle aktuellen Einstellungen unter einem Namen in ~/.config/SimPower/."

#: FFB_Tuner.py:599
msgid "Current Settings"
msgstr "Aktuelle Einstellungen"

#: FFB_Tuner.py:626
msgid "Saved Presets"
msgstr "Gespeicherte Presets"

#: FFB_Tuner.py:633
msgid "No presets saved yet"
msgstr "Noch keine Presets gespeichert"

#: FFB_Tuner.py:634
msgid "Saved presets appear here and in the Presets menu at the top."
msgstr "Gespeicherte Presets erscheinen hier und oben im Presets-Menü."

#: FFB_Tuner.py:665
msgid "Manage Presets"
msgstr "Presets verwalten"

#: FFB_Tuner.py:679
msgid "Quick Setup"
msgstr "Schnelleinrichtung"

#: FFB_Tuner.py:681
msgid "Sim Racing Defaults"
msgstr "Sim-Racing-Standardwerte"

#: FFB_Tuner.py:682
msgid "Balanced steering values for sim racing: 900°, 70 % force feedback, no spring or damper."
msgstr "Ausgewogene Werte für Sim-Racing: 900°, 70 % Force Feedback, keine Feder- oder Dämpfer-Effekte."

#: FFB_Tuner.py:687
msgid "Sim racing defaults applied"
msgstr "Sim-Racing-Standardwerte übernommen"

#: FFB_Tuner.py:693
msgid "Pedal Rumble Test"
msgstr "Pedal-Vibrationstest"

#: FFB_Tuner.py:694
msgid "Sends a single rumble command to ClubSport Pedals V3 or CSL Elite/LC pedals."
msgstr "Sendet einen einzelnen Vibrationsbefehl an ClubSport Pedals V3 oder CSL Elite/LC Pedale."

#: FFB_Tuner.py:697
msgid "Throttle Motor"
msgstr "Gaspedal-Motor"

#: FFB_Tuner.py:698
msgid "Brake Motor"
msgstr "Bremspedal-Motor"

#: FFB_Tuner.py:699
msgid "Duration (×10 ms)"
msgstr "Dauer (×10 ms)"

#: FFB_Tuner.py:705
msgid "Send Rumble"
msgstr "Vibration senden"

#: FFB_Tuner.py:706
msgid "Send"
msgstr "Senden"

#: FFB_Tuner.py:714
msgid "System"
msgstr "System"

#: FFB_Tuner.py:716
msgid "Write Permissions"
msgstr "Schreibrechte"

#: FFB_Tuner.py:717
msgid "Installs a udev rule so settings can be changed without a password prompt."
msgstr "Installiert eine udev-Regel, damit Einstellungen ohne Passwortabfrage geändert werden können."

#: FFB_Tuner.py:719
msgid "Set Up"
msgstr "Einrichten"

#: FFB_Tuner.py:726
msgid "Reset All Tuning Slots"
msgstr "Alle Tuning-Slots zurücksetzen"

#: FFB_Tuner.py:727
msgid "Clears all 5 tuning slots stored on the wheel base."
msgstr "Löscht alle 5 auf der Wheelbase gespeicherten Tuning-Slots."

#: FFB_Tuner.py:728
msgid "Reset…"
msgstr "Zurücksetzen …"

#: FFB_Tuner.py:768
msgid "No Fanatec wheel base found. Check that it is switched on and the hid-fanatecff driver is loaded."
msgstr "Keine Fanatec-Wheelbase gefunden. Prüfe, ob sie eingeschaltet und der hid-fanatecff-Treiber geladen ist."

#: FFB_Tuner.py:770
msgid "Retry"
msgstr "Erneut suchen"

#: FFB_Tuner.py:774
msgid "Changes need a password each time. Set up write permissions to tune live."
msgstr "Änderungen brauchen jedes Mal ein Passwort. Richte Schreibrechte ein, um live zu tunen."

#: FFB_Tuner.py:804
msgid "No device"
msgstr "Kein Gerät"

#: FFB_Tuner.py:816
msgid "In sync with device"
msgstr "Mit Gerät synchron"

#: FFB_Tuner.py:826
msgid "Writing…"
msgstr "Schreibe …"

#: FFB_Tuner.py:847
msgid "Write failed: {names}"
msgstr "Schreiben fehlgeschlagen: {names}"

#: FFB_Tuner.py:849
msgid "Could not write: {names}"
msgstr "Konnte nicht schreiben: {names}"

#: FFB_Tuner.py:864
msgid "Pending changes: {n}"
msgstr "Ausstehende Änderungen: {n}"

#: FFB_Tuner.py:866
msgid "Changes not applied yet"
msgstr "Änderungen noch nicht übernommen"

#: FFB_Tuner.py:900
msgid "Changes undone"
msgstr "Änderungen rückgängig gemacht"

#: FFB_Tuner.py:920
msgid "Could not switch slot"
msgstr "Slot konnte nicht gewechselt werden"

#: FFB_Tuner.py:932
msgid "Could not send rumble"
msgstr "Vibration konnte nicht gesendet werden"

#: FFB_Tuner.py:939
msgid "Setting up permissions failed"
msgstr "Einrichten der Schreibrechte fehlgeschlagen"

#: FFB_Tuner.py:948
msgid "Permissions set up — changes now apply live"
msgstr "Schreibrechte eingerichtet – Änderungen werden jetzt live übernommen"

#: FFB_Tuner.py:963
msgid "Could not load preset"
msgstr "Preset konnte nicht geladen werden"

#: FFB_Tuner.py:969
msgid "Preset “{name}” applied"
msgstr "Preset „{name}“ übernommen"

#: FFB_Tuner.py:970
msgid "Preset “{name}” loaded — click Apply to write it"
msgstr "Preset „{name}“ geladen – zum Schreiben auf Übernehmen klicken"

#: FFB_Tuner.py:973
msgid "e.g. GT3 Race"
msgstr "z. B. GT3-Rennen"

#: FFB_Tuner.py:976
msgid "Save as Preset"
msgstr "Als Preset speichern"

#: FFB_Tuner.py:977
msgid "Saves all current settings under this name."
msgstr "Speichert alle aktuellen Einstellungen unter diesem Namen."

#: FFB_Tuner.py:979
msgid "Cancel"
msgstr "Abbrechen"

#: FFB_Tuner.py:980
msgid "Save"
msgstr "Speichern"

#: FFB_Tuner.py:993
msgid "No Name"
msgstr "Kein Name"

#: FFB_Tuner.py:993
msgid "Enter a name for the preset."
msgstr "Gib einen Namen für das Preset ein."

#: FFB_Tuner.py:1001
msgid "Could not save preset"
msgstr "Preset konnte nicht gespeichert werden"

#: FFB_Tuner.py:1005
msgid "Preset “{name}” saved"
msgstr "Preset „{name}“ gespeichert"

#: FFB_Tuner.py:1010
msgid "Delete “{name}”?"
msgstr "„{name}“ löschen?"

#: FFB_Tuner.py:1011
msgid "The preset file will be removed. This cannot be undone."
msgstr "Die Preset-Datei wird entfernt. Das kann nicht rückgängig gemacht werden."

#: FFB_Tuner.py:1013
msgid "Delete"
msgstr "Löschen"

#: FFB_Tuner.py:1022
msgid "Could not delete preset"
msgstr "Preset konnte nicht gelöscht werden"

#: FFB_Tuner.py:1035
msgid "Reset All Tuning Slots?"
msgstr "Alle Tuning-Slots zurücksetzen?"

#: FFB_Tuner.py:1036
msgid "All 5 tuning slots stored on the wheel base will be cleared. This cannot be undone."
msgstr "Alle 5 auf der Wheelbase gespeicherten Tuning-Slots werden gelöscht. Das kann nicht rückgängig gemacht werden."

#: FFB_Tuner.py:1039
msgid "Reset"
msgstr "Zurücksetzen"

#: FFB_Tuner.py:1048
msgid "Not Available"
msgstr "Nicht verfügbar"

#: FFB_Tuner.py:1049
msgid "This wheel base does not support resetting."
msgstr "Diese Wheelbase unterstützt kein Zurücksetzen."

#: FFB_Tuner.py:1058
msgid "OK"
msgstr "OK"
