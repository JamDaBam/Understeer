msgstr "Linear"

#: understeer/settings.py:74
msgid "Peak"
msgstr "Peak"

#: understeer/settings.py:75
msgid "Linear keeps a constant taper. Peak scales to the strongest force (default)."
msgstr "Linear behält einen gleichmäßigen Verlauf. Peak skaliert auf die stärkste Kraft (Standard)."

#: understeer/settings.py:79
msgid "Force Effect Intensity"
msgstr "Force-Effekt-Intensität"

