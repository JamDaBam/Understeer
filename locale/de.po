msgid "Filters the force feedback signal. Higher values give sharper details."
msgstr "Filtert das Force-Feedback-Signal. Höhere Werte geben schärfere Details."

#: understeer/settings.py:84
msgid "Interpolation Filter"
msgstr "Interpolationsfilter"

#: understeer/settings.py:85
msgid "Smooths between force feedback updates. 0 turns it off."
msgstr "Glättet zwischen Force-Feedback-Updates. 0 schaltet ihn aus."

#: understeer/settings.py:88
msgid "Natural Feel"
msgstr "Natürliches Gefühl"

#: understeer/settings.py:89
msgid "Natural Damper"
msgstr "Natürlicher Dämpfer"

#: understeer/settings.py:90
msgid "Mechanical damping added by the wheel base itself, independent of the game."
msgstr "Mechanische Dämpfung durch die Wheelbase selbst, unabhängig vom Spiel."

#: understeer/settings.py:94
msgid "Natural Friction"
msgstr "Natürliche Reibung"

#: understeer/settings.py:95
msgid "Mechanical friction added by the wheel base itself, independent of the game."
msgstr "Mechanische Reibung durch die Wheelbase selbst, unabhängig vom Spiel."

#: understeer/settings.py:99
msgid "Natural Inertia"
msgstr "Natürliche Trägheit"

#: understeer/settings.py:100
msgid "Mechanical inertia added by the wheel base itself, independent of the game."
msgstr "Mechanische Trägheit durch die Wheelbase selbst, unabhängig vom Spiel."

#: understeer/settings.py:103
msgid "Effects"
msgstr "Effekte"

#: understeer/settings.py:104
msgid "Wheel Vibration"
msgstr "Lenkrad-Vibration"

#: understeer/settings.py:105
msgid "Strength of the rumble on curbs and impacts."
msgstr "Stärke der Vibration bei Curbs und Einschlägen."

#: understeer/settings.py:108
msgid "Drift Mode"
msgstr "Drift-Modus"

#: understeer/settings.py:109
msgid "Negative values help with counter-steering, positive values add centering force. 0 turns it off."
msgstr "Negative Werte helfen beim Gegenlenken, positive Werte erhöhen die Zentrierkraft. 0 schaltet ihn aus."

#: understeer/settings.py:113
msgid "Load Cell Brake"
msgstr "Loadcell-Bremse"

#: understeer/settings.py:114
msgid "Brake Force"
msgstr "Bremskraft"

#: understeer/settings.py:115
msgid "Pedal stiffness. Higher values need more force for full braking. Requires a load cell brake."
msgstr "Pedalhärte. Höhere Werte brauchen mehr Kraft für eine Vollbremsung. Benötigt eine Loadcell-Bremse."

#: understeer/settings.py:119
msgid "Brake Level Indicator"
msgstr "Bremsanzeige (LED)"

#: understeer/settings.py:120
msgid "Brake force at which the LED lights up."
msgstr "Bremskraft, ab der die LED aufleuchtet."

#: understeer/settings.py:122
msgid "Vibration"
msgstr "Vibration"

#: understeer/settings.py:123
msgid "FullForce"
msgstr "FullForce"

#: understeer/settings.py:124
msgid "Pedal vibration routed through the wheel motor. Requires a game with FullForce support."
msgstr "Pedalvibration über den Lenkradmotor. Benötigt ein Spiel mit FullForce-Unterstützung."

#: understeer/settings.py:128
msgid "Analogue Paddles"
msgstr "Analoge Paddles"

#: understeer/settings.py:129
msgid "Paddle Mode"
msgstr "Paddle-Modus"

#: understeer/settings.py:130
msgid "Independent (CbP)"
msgstr "Unabhängig (CbP)"

#: understeer/settings.py:131
msgid "Clutch / Handbrake (CH)"
