msgid "Tools"
msgstr "Werkzeuge"

#: understeer.py:154
msgid "Off"
msgstr "Aus"

#: understeer.py:156
msgid "Counter-steer {n}"
msgstr "Gegenlenken {n}"

#: understeer.py:157
msgid "Centering +{n}"
msgstr "Zentrierung +{n}"

#: understeer.py:164
msgid "Always on"
msgstr "Immer an"

#: understeer.py:170
msgid "Rotation"
msgstr "Rotation"

#: understeer.py:171
msgid "Steering Angle"
msgstr "Lenkwinkel"

#: understeer.py:172
msgid "Total wheel rotation in degrees. Auto uses the maximum range of the wheel base."
msgstr "Gesamter Lenkwinkel in Grad. Auto verwendet den maximalen Bereich der Wheelbase."

#: understeer.py:175
msgid "Force Feedback"
msgstr "Force Feedback"

#: understeer.py:176
msgid "Force Feedback Strength"
msgstr "Force-Feedback-Stärke"

#: understeer.py:177
msgid "Master force feedback output of the wheel base."
msgstr "Gesamtstärke des Force Feedbacks der Wheelbase."

#: understeer.py:179
msgid "Force Effects"
msgstr "Kraft-Effekte"

#: understeer.py:180
msgid "Strength of constant-force effects, the core of the game's force feedback."
msgstr "Stärke der Constant-Force-Effekte, des Kerns des Force Feedbacks im Spiel."

#: understeer.py:183
msgid "Spring Effects"
msgstr "Feder-Effekte"

#: understeer.py:184
msgid "Strength of centering spring effects sent by the game."
msgstr "Stärke der zentrierenden Feder-Effekte aus dem Spiel."

#: understeer.py:186
msgid "Damper Effects"
msgstr "Dämpfer-Effekte"

#: understeer.py:187
msgid "Strength of damper effects sent by the game."
msgstr "Stärke der Dämpfer-Effekte aus dem Spiel."

#: understeer.py:188
msgid "Signal"
msgstr "Signal"

#: understeer.py:189
msgid "Force Feedback Scaling"
msgstr "Force-Feedback-Skalierung"

#: understeer.py:190
msgid "Linear"
msgstr "Linear"

#: understeer.py:190
msgid "Peak"
msgstr "Peak"

#: understeer.py:191
msgid "Linear keeps a constant taper. Peak scales to the strongest force (default)."
msgstr "Linear behält einen gleichmäßigen Verlauf. Peak skaliert auf die stärkste Kraft (Standard)."

#: understeer.py:194
msgid "Force Effect Intensity"
msgstr "Force-Effekt-Intensität"

#: understeer.py:195
msgid "Filters the force feedback signal. Higher values give sharper details."
msgstr "Filtert das Force-Feedback-Signal. Höhere Werte geben schärfere Details."

#: understeer.py:198
msgid "Interpolation Filter"
msgstr "Interpolationsfilter"

#: understeer.py:199
msgid "Smooths between force feedback updates. 0 turns it off."
msgstr "Glättet zwischen Force-Feedback-Updates. 0 schaltet ihn aus."

#: understeer.py:201
msgid "Natural Feel"
msgstr "Natürliches Gefühl"

#: understeer.py:202
msgid "Natural Damper"
msgstr "Natürlicher Dämpfer"

#: understeer.py:203
msgid "Mechanical damping added by the wheel base itself, independent of the game."
msgstr "Mechanische Dämpfung durch die Wheelbase selbst, unabhängig vom Spiel."

#: understeer.py:206
msgid "Natural Friction"
msgstr "Natürliche Reibung"

#: understeer.py:207
msgid "Mechanical friction added by the wheel base itself, independent of the game."
msgstr "Mechanische Reibung durch die Wheelbase selbst, unabhängig vom Spiel."

#: understeer.py:210
msgid "Natural Inertia"
msgstr "Natürliche Trägheit"

#: understeer.py:211
msgid "Mechanical inertia added by the wheel base itself, independent of the game."
msgstr "Mechanische Trägheit durch die Wheelbase selbst, unabhängig vom Spiel."

#: understeer.py:213
msgid "Effects"
msgstr "Effekte"

#: understeer.py:214
msgid "Wheel Vibration"
msgstr "Lenkrad-Vibration"

#: understeer.py:215
msgid "Strength of the rumble on curbs and impacts."
msgstr "Stärke der Vibration bei Curbs und Einschlägen."

#: understeer.py:217
msgid "Drift Mode"
msgstr "Drift-Modus"

#: understeer.py:218
msgid "Negative values help with counter-steering, positive values add centering force. 0 turns it off."
msgstr "Negative Werte helfen beim Gegenlenken, positive Werte erhöhen die Zentrierkraft. 0 schaltet ihn aus."

#: understeer.py:221
msgid "Load Cell Brake"
msgstr "Loadcell-Bremse"

#: understeer.py:222
msgid "Brake Force"
msgstr "Bremskraft"

#: understeer.py:223
msgid "Pedal stiffness. Higher values need more force for full braking. Requires a load cell brake."
msgstr "Pedalhärte. Höhere Werte brauchen mehr Kraft für eine Vollbremsung. Benötigt eine Loadcell-Bremse."

#: understeer.py:226
msgid "Brake Level Indicator"
msgstr "Bremsanzeige (LED)"

#: understeer.py:227
msgid "Brake force at which the LED lights up."
msgstr "Bremskraft, ab der die LED aufleuchtet."

#: understeer.py:228
msgid "Vibration"
msgstr "Vibration"

#: understeer.py:229
msgid "FullForce"
msgstr "FullForce"

#: understeer.py:230
msgid "Pedal vibration routed through the wheel motor. Requires a game with FullForce support."
msgstr "Pedalvibration über den Lenkradmotor. Benötigt ein Spiel mit FullForce-Unterstützung."

#: understeer.py:233
msgid "Analogue Paddles"
msgstr "Analoge Paddles"

#: understeer.py:234
msgid "Paddle Mode"
msgstr "Paddle-Modus"

#: understeer.py:235
msgid "Independent (CbP)"
msgstr "Unabhängig (CbP)"

#: understeer.py:236
msgid "Clutch / Handbrake (CH)"
msgstr "Kupplung / Handbremse (CH)"

#: understeer.py:237
